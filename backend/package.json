{
  "name": "@unitn-asa/deliveroo-js-backend",
  "version": "3.0.3",
  "description": "Deliveroo.js Development Kit - Autonomous Software Agents - 2023",
  "author": "Marco Robol <marco.robol@unitn.it>",
  "license": "ISC",
  "private": true,
  "type": "module",
  "module": "es2022",
  "main": "index.js",
  "bin": {
    "deliveroo-js-server": "./scripts/cli.js"
  },
  "scripts": {
    "prepublishOnly": "",
    "prepare": "",
    "start": "node index.js",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm install && npm run typecheck",
    "build": "npm run build:swagger && node scripts/generateGitRevision.js",
    "build:swagger": "node scripts/generate-swagger.js",
    "predev": "npm run build:swagger",
    "dev": "nodemon --inspect -r dotenv/config index.js --",
    "test": "node --test tests/e2e/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unitn-ASA/Deliveroo.js.git"
  },
  "devDependencies": {
    "dotenv": "^16.0.3",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.7.2",
    "swagger-jsdoc": "^6.3.0"
  },
  "dependencies": {
    "@unitn-asa/deliveroo-js-assets": "*",
    "@unitn-asa/deliveroo-js-sdk": "*",
    "@unitn-asa/deliveroo-js-webapp-dist": "^2.3.1",
    "argparse": "^2.0.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.0",
    "serve-index": "^1.9.1",
    "socket.io": "^4.4.1",
    "swagger-ui-express": "^5.0.1",
    "uid": "^2.0.1"
  },
  "engines": {
    "node": "22.x"
  }
}
